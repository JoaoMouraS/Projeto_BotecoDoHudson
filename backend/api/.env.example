# Copie para ".env" nesta pasta e preencha. O .env NUNCA vai para o git.
# Na hospedagem (produção), cadastre estas mesmas variáveis no painel do serviço.

# --- Banco (Supabase > Connect > Type: JDBC > Session pooler) ---
# Só o endereço + ?sslmode=require (sem user/password na URL)
SUPABASE_DB_URL=jdbc:postgresql://aws-0-SUA-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.SEU_PROJECT_REF
SUPABASE_DB_PASSWORD=

# Gere com: openssl rand -base64 48
JWT_SECRET=

# Admin criado na 1ª execução (senha com 12+ caracteres)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Endereço público do site (links dos e-mails e prévia do WhatsApp) ---
# Dev: http://localhost:5173  |  Produção: https://seu-dominio.com.br
APP_URL=http://localhost:5173

# --- E-mail (SMTP). Vazio = em dev os links aparecem no console ---
# Ex. Brevo: smtp-relay.brevo.com / 587 / login e chave SMTP do painel
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Boteco do Hudson <nao-responda@seu-dominio.com.br>

# --- Sympla (opcional): Minha Conta > Integrações > gerar token ---
SYMPLA_TOKEN=
